# 이 파일을 .env로 복사한 뒤 값을 채운다:  cp .env.example .env

# [필수] Agent LLM (gpt-4o-mini)
OPENAI_API_KEY=

# [선택] LangSmith 트레이싱
# 키가 없으면 LANGCHAIN_TRACING_V2=false로 바꾼다 (true인데 키가 없으면 인증 오류가 반복 출력됨)
# 프로젝트명은 코드(core/tracing.py)에서 U_2_4로 고정한다
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=U_2_4

# [선택] Hugging Face 토큰: 임베딩 모델 다운로드 속도 제한 완화용 (없어도 동작)
HF_TOKEN=
